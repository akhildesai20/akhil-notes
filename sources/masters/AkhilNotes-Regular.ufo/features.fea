pos mark dieresiscomb <anchor 0 57> mark @top;
pos mark hookabovecomb <anchor 0 151> mark @top;
pos mark ringcomb <anchor 0 176> mark @top;
pos mark hungarumlautcomb <anchor 0 126> mark @top;
pos mark caroncomb <anchor 0 126> mark @top;
} mkmk;
@AboveMarks = [gravecomb acutecomb circumflexcomb tildecomb macroncomb brevecomb dotaccentcomb dieresiscomb hookabovecomb ringcomb hungarumlautcomb caroncomb circumflexcomb_gravecomb circumflexcomb_acutecomb circumflexcomb_tildecomb circumflexcomb_hookabovecomb brevecomb_gravecomb brevecomb_acutecomb brevecomb_tildecomb brevecomb_hookabovecomb];
feature ccmp { sub circumflexcomb gravecomb by circumflexcomb_gravecomb; sub circumflexcomb acutecomb by circumflexcomb_acutecomb; sub circumflexcomb tildecomb by circumflexcomb_tildecomb; sub circumflexcomb hookabovecomb by circumflexcomb_hookabovecomb; sub brevecomb gravecomb by brevecomb_gravecomb; sub brevecomb acutecomb by brevecomb_acutecomb; sub brevecomb tildecomb by brevecomb_tildecomb; sub brevecomb hookabovecomb by brevecomb_hookabovecomb; sub i' @AboveMarks by idotless; sub j' @AboveMarks by jdotless; sub [d l t L] caroncomb' by caroncomb.alt; } ccmp;
@BelowMarks = [dotbelowcomb commaaccentcomb cedillacomb ogonekcomb];
feature ccmp { sub i' @BelowMarks @AboveMarks by idotless; sub j' @BelowMarks @AboveMarks by jdotless; sub idotbelow' @AboveMarks by idotless dotbelowcomb; sub iogonek' @AboveMarks by idotless ogonekcomb; } ccmp;
feature locl { script latn; language CAT; sub l periodcentered' l by periodcentered.loclCAT; sub L periodcentered' L by periodcentered.loclCAT.case; language TRK exclude_dflt; sub i by idotaccent; } locl;
feature tnum { sub [zero one two three four five six seven eight nine] by [zero.tf one.tf two.tf three.tf four.tf five.tf six.tf seven.tf eight.tf nine.tf]; } tnum;
feature pnum { sub [zero.tf one.tf two.tf three.tf four.tf five.tf six.tf seven.tf eight.tf nine.tf] by [zero one two three four five six seven eight nine]; } pnum;
feature numr { sub [zero one two three four five six seven eight nine] by [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr]; } numr;
feature dnom { sub [zero one two three four five six seven eight nine] by [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom]; } dnom;
feature sups { sub [zero one two three four five six seven eight nine] by [uni2070 onesuperior twosuperior threesuperior foursuperior fivesuperior sixsuperior sevensuperior eightsuperior ninesuperior]; } sups;
feature subs { sub [zero one two three four five six seven eight nine] by [uni2080 oneinferior twoinferior threeinferior fourinferior fiveinferior sixinferior seveninferior eightinferior nineinferior]; } subs;
lookup NumSub { sub [zero one two three four five six seven eight nine] by [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr]; } NumSub; lookup DenSub { sub [zero one two three four five six seven eight nine] by [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom]; } DenSub;
lookup FracSlash { sub [zero one two three four five six seven eight nine] slash' [zero one two three four five six seven eight nine] by fraction; } FracSlash;
lookup FracNum1 { sub [zero one two three four five six seven eight nine]' lookup NumSub fraction; } FracNum1;
lookup FracNum2 { sub [zero one two three four five six seven eight nine]' lookup NumSub [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr]; } FracNum2;
lookup FracNum3 { sub [zero one two three four five six seven eight nine]' lookup NumSub [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr]; } FracNum3;
lookup FracNum4 { sub [zero one two three four five six seven eight nine]' lookup NumSub [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr]; } FracNum4;
lookup FracDen1 { sub fraction [zero one two three four five six seven eight nine]' lookup DenSub; } FracDen1;
lookup FracDen2 { sub [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom] [zero one two three four five six seven eight nine]' lookup DenSub; } FracDen2;
feature frac { lookup FracSlash; lookup FracNum1; lookup FracNum2; lookup FracNum3; lookup FracNum4; lookup FracDen1; lookup FracDen2; } frac;
feature zero { sub zero by zero.zero; } zero;
feature liga { sub f f i by f_f_i; sub f f l by f_f_l; sub f f by f_f; sub f i by f_i; sub f l by f_l; } liga;
feature dlig { sub F f i by F_f_i; sub F f l by F_f_l; sub I n g by I_n_g; sub i n g by i_n_g; sub A a by A_a; sub A n by A_n; sub A s by A_s; sub A t by A_t; sub B b by B_b; sub C c by C_c; sub C h by C_h; sub C k by C_k; sub C t by C_t; sub D d by D_d; sub E e by E_e; sub E r by E_r; sub F f by F_f; sub F i by F_i; sub F l by F_l; sub G g by G_g; sub G h by G_h; sub H e by H_e; sub H i by H_i; sub I c by I_c; sub I i by I_i; sub I n by I_n; sub I o by I_o; sub L e by L_e; sub L i by L_i; sub L l by L_l; sub L y by L_y; sub M m by M_m; sub N g by N_g; sub N n by N_n; sub O o by O_o; sub P h by P_h; sub P p by P_p; sub Q u by Q_u; sub R r by R_r; sub S h by S_h; sub S k by S_k; sub S p by S_p; sub S s by S_s; sub S t by S_t; sub T h by T_h; sub T t by T_t; sub U u by U_u; sub W h by W_h; sub Z z by Z_z; sub a a by a_a; sub a n by a_n; sub a s by a_s; sub a t by a_t; sub b b by b_b; sub c c by c_c; sub c h by c_h; sub c k by c_k; sub c t by c_t; sub d d by d_d; sub e e by e_e; sub e r by e_r; sub g g by g_g; sub g h by g_h; sub h e by h_e; sub h i by h_i; sub i c by i_c; sub i i by i_i; sub i n by i_n; sub i o by i_o; sub l e by l_e; sub l i by l_i; sub l l by l_l; sub l y by l_y; sub m m by m_m; sub n g by n_g; sub n n by n_n; sub o o by o_o; sub p h by p_h; sub p p by p_p; sub q u by q_u; sub r r by r_r; sub s h by s_h; sub s k by s_k; sub s p by s_p; sub s s by s_s; sub s t by s_t; sub t h by t_h; sub t t by t_t; sub u u by u_u; sub w h by w_h; sub z z by z_z; } dlig;
